# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Invite codes you make up and share privately with classroom families.
# Anyone with the parent code can join as a parent; the admin code makes
# whoever uses it the room-parent admin. Keep the admin code to yourself.
CLASSROOM_PARENT_INVITE_CODE=
CLASSROOM_ADMIN_INVITE_CODE=

# Resend — resend.com → API Keys. Sends the weekly reminder email digest
# and the "you've been invited" emails from Admin → Invite families.
RESEND_API_KEY=
# Must be an email address on a domain you've verified in Resend.
RESEND_FROM_EMAIL="1st Grade Class <updates@yourdomain.com>"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set
# this in Vercel env vars and Vercel wires it up automatically.
CRON_SECRET=

# Public URL of your deployed app, used as the "Open the app" link in emails.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Web Push (phone notifications) — generate a keypair with:
#   npx web-push generate-vapid-keys
# then paste the two keys below. VAPID_SUBJECT is just a contact URL/email
# push services may use to reach you about your usage — any mailto: works.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Gifts & donations (Stripe Connect) — dashboard.stripe.com/apikeys.
# Start with the test-mode secret key (sk_test_...) until you're ready to
# take real money. Whoever's collecting connects their own bank account
# through Stripe Express (Directory tab won't show this — it's in Admin);
# this app never holds funds itself.
STRIPE_SECRET_KEY=

# dashboard.stripe.com/webhooks — add an endpoint pointing at
# https://your-app.vercel.app/api/webhooks/stripe, listening for
# checkout.session.completed, checkout.session.async_payment_succeeded,
# and checkout.session.async_payment_failed. Paste the signing secret
# (whsec_...) it gives you.
STRIPE_WEBHOOK_SECRET=
